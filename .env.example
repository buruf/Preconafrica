DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Neon's unpooled endpoint — the same URL with `-pooler` removed from the host.
# Required by `prisma db push` and by migrations: DDL cannot run through
# PgBouncer, so without this the schema cannot be applied at all.
DIRECT_URL=""
NEXTAUTH_SECRET=""
# The app's public origin, used to build absolute links in outgoing email
# (password resets, payment reminders) — those are clicked from a mail client
# with no origin to resolve a relative path against.
NEXTAUTH_URL="http://localhost:3000"
# next-auth v5's preferred name for the same thing. Set either one: the code
# reads NEXTAUTH_URL first and falls back to AUTH_URL. Setting neither does not
# crash anything — it silently mails relative links that go nowhere.
AUTH_URL=""
RESEND_API_KEY=""
EMAIL_FROM="Sunrise Developments <noreply@example.com>"
CRON_SECRET=""
