DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Neon's unpooled endpoint — the same URL with `-pooler` removed from the host.
# Required by `prisma db push` and by migrations: DDL cannot run through
# PgBouncer, so without this the schema cannot be applied at all.
DIRECT_URL=""
NEXTAUTH_SECRET=""
# The app's public origin, used to build absolute links in outgoing email
# (password resets, payment reminders) — those are clicked from a mail client
# with no origin to resolve a relative path against.
NEXTAUTH_URL="http://localhost:3000"
# next-auth v5's preferred name for the same thing. Set either one: the code
# reads NEXTAUTH_URL first and falls back to AUTH_URL. Setting neither does not
# crash anything — it silently mails relative links that go nowhere.
AUTH_URL=""
RESEND_API_KEY=""
EMAIL_FROM="Sunrise Developments <noreply@example.com>"
CRON_SECRET=""

# The production branch host, e.g. ep-xxxx.region.aws.neon.tech (bare host, no
# scheme). prisma/seed.ts refuses to run when DATABASE_URL resolves to this
# branch, because seeding deletes every row before it writes any. Pooled and
# direct endpoints of the same branch both match. Unset means the guard cannot
# tell development from production, so it refuses everything — it fails closed.
PROTECTED_DB_HOST=""

# ─── Error monitoring (optional; unset is a fully supported state) ────────────
# Sentry is wired up but completely inert until a DSN exists. With both of the
# names below unset the app builds, runs and tests exactly as it does without
# Sentry installed: next.config.mjs does not wrap the build, so the SDK never
# reaches the client bundle, and none of the three runtime configs creates a
# client, so nothing is ever sent anywhere.
#
# A DSN is not a secret — it is embedded in every client bundle that uses one.
# NEXT_PUBLIC_SENTRY_DSN is the only spelling the browser can read; setting just
# that one enables the browser, the server and the edge at once, which is what
# most deployments want.
NEXT_PUBLIC_SENTRY_DSN=""
# Server- and edge-only alternative. Set this instead of the public name to
# report from the server while leaving the browser silent. Read as a fallback,
# so setting both is harmless and the public one wins.
SENTRY_DSN=""

# Source-map upload, all three needed together and all three optional. With a
# DSN but no auth token, server stack traces are readable and client ones are
# minified, and the build does not spend any time uploading anything. Adding the
# token turns the upload on — it is opt-in separately because that is the step
# that lengthens a build and can fail it.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
