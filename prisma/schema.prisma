generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Pooled endpoint (PgBouncer) for application queries.
  url       = env("DATABASE_URL")
  /// Unpooled endpoint. DDL cannot run through PgBouncer, so Prisma uses
  /// this one for schema pushes and migrations.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  AGENT
  BUYER

  /// **Never held by a `User`.** This value exists so `AuditEntry.actorRole`
  /// can name the platform operator when an action taken from the console —
  /// suspending a developer — is recorded in *that developer's own* log, where
  /// they can read it. The alternative was recording it as ADMIN, which would
  /// be a false record in the one table that must never contain one.
  ///
  /// Nothing writes it to `User.role`, and `SessionActor['role']` is a separate
  /// hand-written union of the three real roles, so a row carrying this could
  /// not be admitted anywhere: `assertRole` matches against that union and
  /// would refuse it, `requireStaff` and `requireAdmin` with it. It fails
  /// closed, which is the direction an accident here has to fail.
  PLATFORM
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum PlanType {
  FULL
  INSTALLMENTS
}

enum SaleStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  CASH
  CHEQUE
  OTHER
}

/// EMAIL and SMS both exist from day one so adding SMS delivery later
/// requires an adapter and a config flag, never a migration.
enum ReminderChannel {
  EMAIL
  SMS
}

/// How a developer charges for letting a buyer pay over time: as a percentage
/// of the financed amount, or as one flat sum of money.
///
/// FIXED is not a convenience variant of PERCENT and must not be "simplified"
/// away. A percentage of the financed amount *is* interest — the charge grows
/// with the sum borrowed and with nothing else — and interest is not
/// permissible in several of the markets this platform serves. A developer
/// there has to be able to name one flat fee for the service of spreading the
/// payments: the same fee whether the unit costs 20 million or 200. Collapsing
/// FIXED into "PERCENT with the rate worked out per sale" does not preserve
/// that, because the charge would once again be a function of the amount
/// financed, which is exactly the thing that is not allowed.
///
/// Two rules elsewhere follow from this and are load-bearing: no percentage may
/// ever be printed beside a FIXED charge (see `installmentFeeRateSuffix` in
/// domain/schedule.ts), and a FIXED fee is bounded by the financed amount
/// rather than by a 0–10000 range (see `computeInstallmentFeeMinor`).
enum InstallmentFeeMode {
  PERCENT
  FIXED
}

enum DocumentType {
  INVOICE
  RECEIPT
  STATEMENT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  /// Monotonic counter backing per-org document numbering.
  documentSeq Int       @default(0)
  /// Set by a platform admin to stop this developer's staff signing in.
  ///
  /// Checked in `requireUser` on every authenticated request, alongside
  /// `User.disabledAt`, so a suspension bites on the next navigation rather
  /// than whenever a seven-day JWT happens to expire.
  ///
  /// Deliberately does *not* lock out buyers. A developer's dispute with the
  /// platform is not their buyers' dispute: the contracts, receipts and
  /// statements someone already holds for a flat they are paying for stay
  /// downloadable. Nothing financial is ever deleted by a suspension.
  suspendedAt DateTime?
  /// Why, in the operator's own words, shown to the suspended developer's own
  /// staff on the screen that tells them they are locked out.
  ///
  /// Optional, because "suspended with no reason given" is an honest state and
  /// forcing a sentence would only produce empty ones. Cleared when the
  /// suspension is lifted, so a stale reason can never sit beside an active
  /// organisation.
  suspensionReason String?
  createdAt   DateTime  @default(now())

  users         User[]
  projects      Project[]
  buyers        Buyer[]
  sales         Sale[]
  payments      Payment[]
  documents     Document[]
  notifications NotificationLog[]
}

model User {
  id                String    @id @default(cuid())
  orgId             String
  email             String    @unique
  passwordHash      String
  fullName          String
  role              UserRole
  /// Set when the account is deactivated, and the authoritative answer to
  /// "may this user act?". Read on every authenticated request (requireUser)
  /// so an already-issued JWT stops working the moment an admin deactivates
  /// the account — overwriting the password hash alone only blocks future
  /// logins and leaves the existing session valid until it expires.
  disabledAt        DateTime?
  /// Stamped every time the password changes — by self-service change or by
  /// reset. A JWT cannot be revoked from the outside, so this field is what
  /// revokes one: `requireUser` compares it against the token's `iat` on every
  /// authenticated request and sends anything issued at or before the change
  /// back to /login. Without it, resetting a password a thief already used
  /// would block them at the login form while leaving the session they already
  /// hold valid for up to a week — the opposite of what a reset is for. Null
  /// means the password has never changed, so no session can predate a change.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())

  org                 Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  buyer               Buyer?
  passwordResetTokens PasswordResetToken[]

  @@index([orgId])
}

/// A single-use, one-hour credential for proving control of an account's email
/// address. Only the sha256 of the token is stored — the raw value exists in
/// the reset email and nowhere else, so a database leak yields nothing an
/// attacker can present at /reset-password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// sha256 hex of the raw token; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  /// Set the moment the token is spent — and also when it is superseded by a
  /// newer request or by any password change, which is what makes "at most one
  /// live reset link per account" true rather than merely likely.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  /// Cascade, deliberately, and unlike every financially sensitive relation in
  /// this schema: these are throwaway credentials, not financial records. A
  /// deleted user must not leave live reset tokens behind pointing at an
  /// account that no longer exists, and there is nothing here anyone could
  /// need to audit or reconstruct later. Contrast Sale/Payment/Document, which
  /// are Restrict precisely because losing them silently destroys money
  /// history — see the schema-contract guard test.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id                       String             @id @default(cuid())
  orgId                    String
  name                     String
  location                 String
  /// ISO-4217 code. There is no default — every project states its own.
  currency                 String
  expectedCompletion       DateTime
  floors                   Int
  unitsPerFloor            Int
  startFloor               Int                @default(1)
  namingPattern            String
  /// The building's photo, as an `https` URL an admin pasted. Nullable, and
  /// nullable is the ordinary case: a project with no photo shows a labelled
  /// placeholder wherever the photo would go, so nothing about a page's or a
  /// PDF's layout depends on one being set. There is deliberately no upload
  /// pipeline behind this (no blob storage, no new service, no cost) — the URL
  /// is checked by `checkImageUrl` at input time and re-checked by the
  /// server-side SSRF guard before any PDF embeds it.
  heroImageUrl             String?
  /// Which of the two fields below is the project's default charge. PERCENT
  /// reads `installmentMarkupBps`; FIXED reads `installmentFixedFeeMinor`. The
  /// unused one is kept at zero rather than nulled, so switching a project's
  /// mode never loses the rate it used to charge. See `InstallmentFeeMode`.
  installmentFeeMode       InstallmentFeeMode @default(PERCENT)
  /// The PERCENT default, in basis points of the financed amount (price less
  /// deposit). 1000 = 10%. Basis points rather than a decimal percentage so the
  /// charge is an exact integer and the whole calculation can stay in BigInt.
  /// Int, not BigInt: this is a count of hundredths of a percent, capped at
  /// 10000, never an amount of money.
  installmentMarkupBps     Int                @default(0)
  /// The FIXED default: a flat charge in minor units of the project's currency,
  /// the same whatever the unit costs. BigInt for the reason every other money
  /// column is one — a NGN fee overflows Int32 as readily as a NGN price does.
  installmentFixedFeeMinor BigInt             @default(0)
  reminderDaysBefore       Int                @default(7)
  overdueNoticeDaysAfter   Int                @default(3)
  reminderChannels         ReminderChannel[]  @default([EMAIL])
  createdAt                DateTime           @default(now())

  org    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  units  Unit[]
  sales  Sale[]
  images ProjectImage[]

  @@index([orgId])
}

/// A photograph of something the whole development shares — the gym, the pool,
/// the lobby, the landscaping.
///
/// A table rather than a `String[]` on `Project`, and the caption is the whole
/// reason. An array of URLs cannot hold "Rooftop pool" beside the picture of
/// one, and a gallery of unlabelled amenity shots asks the buyer to guess what
/// they are looking at.
///
/// It belongs to the project, not to a unit. `Unit.renderImageUrls` is the only
/// other multi-image field and it is the wrong home for this: a gym is not part
/// of flat 12B, and putting it there would mean uploading the same photograph
/// onto all sixty-four units.
///
/// `onDelete: Cascade`, unlike everything financial in this schema: these are
/// presentation, not records. A project cannot be deleted while it has sales
/// anyway — `Sale` is `Restrict` — so this cascade only ever fires for a project
/// that never sold anything.
model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  /// An https URL from the blob store, same as every other image column.
  url       String
  /// What it is a picture of. Optional: a photograph with no caption is worth
  /// showing, and forcing one only produces empty strings.
  caption   String?
  /// Display order. Set to the end on insert, so the gallery reads in the order
  /// the admin uploaded — the column exists so reordering is a UI change later
  /// rather than a migration.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

model Unit {
  id              String     @id @default(cuid())
  projectId       String
  name            String
  floor           Int
  bedrooms        Int
  sizeSqm         Decimal    @db.Decimal(10, 2)
  /// Minor units. BigInt because a NGN tower unit overflows Int32.
  priceMinor      BigInt
  status          UnitStatus @default(AVAILABLE)
  /// The floor-plan drawing for this unit — one image, same rules as
  /// `Project.heroImageUrl`.
  layoutImageUrl  String?
  /// Artist's impressions, several per unit, in the order an admin listed them.
  /// A list rather than a join table because these are ordered opaque strings
  /// with nothing hanging off them, and `String[]` with no default is an empty
  /// array on every existing row — so the column arrives without a backfill.
  /// Capped at MAX_RENDER_IMAGES by `parseRenderUrls` at input time; the
  /// database does not enforce a length, so the guard is the cap.
  renderImageUrls String[]
  createdAt       DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sale    Sale?

  @@unique([projectId, name])
  @@index([projectId, floor])
  @@index([projectId, status])
}

model Buyer {
  id        String   @id @default(cuid())
  orgId     String
  userId    String   @unique
  fullName  String
  /// Stored E.164 with country code, validated at registration.
  phone     String
  email     String
  address   String?
  smsOptIn  Boolean  @default(true)
  createdAt DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@index([orgId])
}

model Sale {
  id              String             @id @default(cuid())
  orgId           String
  projectId       String
  unitId          String             @unique
  buyerId         String
  planType        PlanType
  /// Snapshot at signing. Repricing the unit must not alter a signed contract.
  priceMinor      BigInt
  depositMinor    BigInt             @default(0)
  /// All three snapshotted at signing, for exactly the reason priceMinor and
  /// currency are: re-rating the project — or switching it from a percentage to
  /// a flat fee, or the reverse — must not silently restate a contract someone
  /// has already signed. The mode decides which of the two values is the charge;
  /// both are zero for a FULL plan, which finances nothing.
  ///
  /// Every sale signed before FIXED existed carries PERCENT and its original
  /// bps, so nothing already agreed changes value.
  feeMode         InstallmentFeeMode @default(PERCENT)
  /// Basis points of the financed amount, read when feeMode is PERCENT.
  markupBps       Int                @default(0)
  /// A flat charge in minor units, read when feeMode is FIXED.
  fixedFeeMinor   BigInt             @default(0)
  currency        String
  termMonths      Int?
  signedAt        DateTime
  status          SaleStatus         @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime           @default(now())

  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  unit            Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  buyer           Buyer           @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  scheduleEntries ScheduleEntry[]
  payments        Payment[]
  documents       Document[]

  @@index([orgId, status])
  @@index([buyerId])
  @@index([projectId])
}

model ScheduleEntry {
  id              String    @id @default(cuid())
  saleId          String
  sequence        Int
  dueDate         DateTime
  amountDueMinor  BigInt
  /// Maintained transactionally as the sum of this entry's allocations.
  /// Status is NOT stored — it is derived from this plus the current date.
  amountPaidMinor BigInt    @default(0)
  paidAt          DateTime?

  sale          Sale                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  allocations   PaymentAllocation[]
  notifications NotificationLog[]
  document      Document?

  @@unique([saleId, sequence])
  @@index([dueDate])
  @@index([saleId])
}

model Payment {
  id               String        @id @default(cuid())
  orgId            String
  saleId           String
  amountMinor      BigInt
  receivedAt       DateTime
  method           PaymentMethod
  reference        String?
  note             String?
  recordedByUserId String
  /// Payments are immutable by policy: a mistake is voided below, never edited.
  /// Deletion is Restrict-protected — this row cannot be deleted while an
  /// allocation or document references it, and no ancestor (Sale, Unit,
  /// Organization, Project) can cascade-delete it away.
  voidedAt         DateTime?
  voidedByUserId   String?
  voidReason       String?
  createdAt        DateTime      @default(now())

  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sale        Sale                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  document    Document?

  @@index([saleId, receivedAt])
  @@index([orgId])
}

model PaymentAllocation {
  id              String @id @default(cuid())
  paymentId       String
  scheduleEntryId String
  amountMinor     BigInt

  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  scheduleEntry ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Restrict)

  @@unique([paymentId, scheduleEntryId])
  @@index([scheduleEntryId])
}

model Document {
  id              String       @id @default(cuid())
  orgId           String
  saleId          String
  type            DocumentType
  /// Human-facing, stable, sequential per organisation, e.g. INV-000042.
  number          String
  sequence        Int
  /// Set for INVOICE. Unique so an entry cannot be double-invoiced.
  scheduleEntryId String?      @unique
  /// Set for RECEIPT. Unique so a payment cannot yield two receipts.
  paymentId       String?      @unique
  createdAt       DateTime     @default(now())

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  scheduleEntry ScheduleEntry? @relation(fields: [scheduleEntryId], references: [id], onDelete: Restrict)
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@index([saleId, type])
}

model NotificationLog {
  id                String             @id @default(cuid())
  orgId             String
  scheduleEntryId   String
  channel           ReminderChannel
  templateKey       String
  /// Email address or E.164 number, depending on channel.
  destination       String
  status            NotificationStatus @default(PENDING)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())

  /// Cascade is safe here: NotificationLog.scheduleEntryId is required, and every
  /// ScheduleEntry requires a Sale, whose own relation (Sale.org, above) is
  /// Restrict — so an Organization can never be deleted while any Sale (and
  /// therefore any NotificationLog under it) exists. Deleting an org with zero
  /// sales also has zero NotificationLog rows to lose. See the schema-contract
  /// guard test: Organization is deliberately NOT in its financially-sensitive
  /// set, because this path is unreachable in practice, not because it's unchecked.
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scheduleEntry ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Restrict)

  /// The idempotency guard: a retried cron run cannot double-send.
  @@unique([scheduleEntryId, templateKey, channel])
  @@index([orgId, createdAt])
}

/// One fixed-window counter for the rate limiter: a key, when its window
/// opened, and how many attempts have landed in it.
///
/// Postgres rather than Redis because this project runs no Redis and a login
/// attempt is a write it can afford — see the header of src/server/rate-limit.ts.
/// One row per (key, tier), so a policy's per-minute and per-hour budgets never
/// share a counter.
///
/// The key is the primary key rather than a surrogate id with a unique index,
/// because the whole access pattern is `INSERT ... ON CONFLICT ("key") DO
/// UPDATE`: Postgres needs a unique constraint on that column to arbitrate the
/// conflict, and a second identifier would be a column nothing ever reads.
///
/// Both timestamps are `Timestamptz` on purpose. The increment statement
/// compares `windowStart` against a parameter computed in JavaScript, and a
/// naive `timestamp` column would make that comparison depend on the session's
/// TimeZone setting — a rate limiter that is an hour out on some connections is
/// worse than none, because it looks like it is working.
///
/// Holds no personal data beyond an email address and a source address inside
/// the key, and every row is deleted by `purgeExpiredRateLimitHits` once its
/// window is over.
model RateLimitHit {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)
  /// The end of this row's window: the cron reaper's only filter.
  expiresAt   DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

/// The system of record's memory: who changed money, inventory or access, what
/// they changed it from and to, and when.
///
/// This exists because the questions a system of record exists to answer — who
/// changed that unit's price, who voided that payment, who cancelled that sale
/// — were unanswerable. Scattered columns hinted at it (`recordedByUserId`,
/// `voidedByUserId`, `voidReason`) but nothing was queryable and nothing
/// covered edits at all. History that was not recorded cannot be backfilled,
/// which is why this landed before the features that will fill it.
///
/// ## Append-only, and enforced rather than hoped for
///
/// Nothing in this application may update or delete one of these rows. Two
/// mechanisms hold that, neither of which is a comment:
///
///   1. A Postgres trigger (`prisma/audit-immutability.sql`, applied by
///      `scripts/ensure-audit-immutability.mjs`, which `npm run db:push` runs
///      afterwards) raises an exception on any UPDATE or DELETE. That one holds
///      against raw SQL, a psql session and a future ORM alike.
///   2. Prisma middleware in `src/server/db.ts` refuses the same operations
///      before they leave the process, so a mistake fails with a sentence a
///      developer can read rather than a database error at the end of a
///      transaction.
///
/// ## Deliberately never reaped
///
/// The daily cron reaps expired reset tokens and rate-limit counters. Do not
/// add these rows to it by analogy: those two are throwaway state that means
/// nothing a week later, and this is the one table whose entire value is that
/// it still holds what happened four years ago. See the note in
/// `src/app/api/cron/reminders/route.ts`.
///
/// ## No relations, deliberately
///
/// `actorUserId`, `entityId` and everything in `context` are plain strings, not
/// foreign keys — the same choice `Sale.createdByUserId` already makes. A
/// relation would force a bad answer either way: `Cascade` would let deleting a
/// user or a project erase the record of what they did, and `Restrict` would
/// let the audit log veto ordinary administration forever. The log is a record
/// of the past, and the past does not hold references to the present. What it
/// needs from the present it *snapshots* — `actorName`, `actorRole`,
/// `entityLabel` — so an entry still reads correctly after the actor is
/// deactivated or the unit is renamed.
model AuditEntry {
  id String @id @default(cuid())

  /// Tenant scope, on every entry, exactly like every other table here.
  orgId String

  /// Who acted. A plain id (see above) plus the two things about them that
  /// were true at the time and may not be later: their name and their role.
  actorUserId String
  actorName   String
  actorRole   UserRole

  /// The business event, as `entity.verb` — 'payment.voided', 'unit.updated'.
  /// A string rather than an enum: the vocabulary grows with every feature, and
  /// a new verb must never require a migration before it can be recorded.
  /// `describeAuditEntry` in src/domain/audit.ts renders each one, and falls
  /// back to a readable sentence for any it does not know.
  action String

  /// What it happened to: the model name and its id, plus that entity's human
  /// name *as it was*. The label is what makes "voided a payment on unit 4C"
  /// keep saying 4C after the unit is renamed 4C-PH.
  entityType  String
  entityId    String
  entityLabel String?

  /// Only the fields that actually changed, each as `{field, from, to}` with a
  /// tagged value that knows whether it is money, an enum, a date or an image —
  /// never a dump of the whole row. Money travels as a decimal string of minor
  /// units alongside its currency, because JSON has no BigInt and because a
  /// figure without its currency is not an amount. See `AuditChange` in
  /// src/domain/audit.ts.
  changes Json @default("[]")

  /// The ids and snapshots a sentence needs but the entity does not carry —
  /// the sale a payment belongs to, the project a unit is in, the reason a
  /// payment was voided. See `AuditContext` in src/domain/audit.ts.
  context Json @default("{}")

  createdAt DateTime @default(now())

  /// One index, and one on purpose.
  ///
  /// Every read of this table is "this organisation, newest first", optionally
  /// narrowed by entity type, actor or date — so `(orgId, createdAt)` serves
  /// the ordering, the tenant scope and the date range, and Postgres scans it
  /// backwards for DESC without needing a second, descending copy. The two
  /// filters ride on top as a filter over an already tight range.
  ///
  /// A busy month for one developer is on the order of a thousand entries (see
  /// the /audit page's note), so the filters do not yet earn indexes of their
  /// own, and this is the table every money write now pays an insert into —
  /// each extra index is a cost on every payment, every sale and every edit. If
  /// an organisation ever reaches millions of rows, add
  /// `@@index([orgId, entityType, createdAt])` then, on evidence.
  @@index([orgId, createdAt])
}

/// A platform operator — the person who runs PreCon Africa itself, not a
/// developer using it.
///
/// A separate table rather than a nullable `User.orgId` plus a PLATFORM role,
/// and the reason is worth stating because the tempting version is genuinely
/// dangerous. Every query in this system is scoped `where: { orgId: ... }`
/// with the id taken from the session — and in Prisma, `orgId: undefined` does
/// not mean "no organisation", it means *no constraint*, returning every
/// tenant's rows. Making that column nullable would convert the one invariant
/// this whole codebase rests on into a runtime hazard across dozens of
/// financial queries, silently, with no type error at any call site.
///
/// Kept apart, a platform admin has no row in `User` at all: no org-scoped
/// query can return them, and `assertRole` can never admit them. The
/// separation is structural rather than remembered.
///
/// Carries the same two revocation columns as `User`, for the same reasons —
/// see the comments there.
model PlatformUser {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  fullName          String
  disabledAt        DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
}

/// What a platform operator did, append-only.
///
/// Separate from `AuditEntry` because that log is org-scoped and a platform
/// action crosses organisations — and because the platform admin deliberately
/// cannot read a developer's data, so an entry written into a developer's log
/// would be one they could never see. The same Postgres trigger that makes
/// `AuditEntry` refuse UPDATE, DELETE and TRUNCATE is applied to this table by
/// `scripts/ensure-audit-immutability.mjs`.
///
/// Known gap: a developer cannot yet see in their own log that they were
/// suspended, or by whom. Worth adding; not worth blocking the console on.
model PlatformAuditEntry {
  id          String   @id @default(cuid())
  actorUserId String
  actorName   String
  action      String
  entityType  String
  entityId    String
  entityLabel String?
  context     Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
